# Which of the two setups this server is (deploy/README.md):
#   online — API on Render, web app on Vercel, database on MongoDB Atlas
#   local  — everything on the shop's Windows server (deploy/windows/install.ps1 writes this file)
# Decides the rest by itself (server/src/config/deployMode.js): local hands out
# the web app and has no photo-evidence size limit; online does neither.
DEPLOY_MODE=online

# online: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hr_system?retryWrites=true&w=majority
# local:  mongodb://127.0.0.1:27017/romeo-hr
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hr_system?retryWrites=true&w=majority
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PORT=4000

# online: the web app's address (Vercel), for CORS. local: not needed.
CLIENT_ORIGIN=http://localhost:5173

# local: where the built web app is, relative to the server folder (default ../client/dist).
# CLIENT_DIST=../client/dist

# Photo evidence ceiling in MB — default 450 online (Atlas free tier), 0 = none locally.
# Set it to the plan's size if Atlas is upgraded.
# EVIDENCE_DB_LIMIT_MB=450

# Shared secret for POST /api/attendance/push (terminal middleware that can't carry
# a user JWT). Leave unset to disable the route entirely (it 401s on every call).
# DEVICE_PUSH_SECRET=change-me
